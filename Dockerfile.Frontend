# Dockerfile for LMS-Frontend
#
# This multi-stage Dockerfile builds the React/TypeScript frontend for production
# and provides a separate target for an efficient development environment.

# ==============================================================================
# BASE STAGE
# ==============================================================================
FROM rust:alpine AS base

# Install essential dependencies
RUN apk add --no-cache curl bash unzip

# Install fnm using the direct binary method (more reliable)
RUN curl -fsSL https://github.com/Schniz/fnm/releases/latest/download/fnm-linux.zip -o fnm.zip \
    && unzip fnm.zip \
    && chmod +x fnm \
    && mv fnm /usr/local/bin/fnm \
    && rm fnm.zip

# Create fnm directories and set up environment
RUN mkdir -p /root/.local/share/fnm && \
    mkdir -p /root/.fnm

ENV FNM_DIR=/root/.fnm
ENV PATH=/root/.local/share/fnm/current/bin:/root/.fnm:$PATH

# Install Node.js 22 LTS using fnm
RUN fnm install --fnm-dir /root/.fnm 22 && \
    fnm use --fnm-dir /root/.fnm 22 && \
    fnm default --fnm-dir /root/.fnm 22

# Verify Node.js installation
RUN /root/.local/share/fnm/current/bin/node --version

# Enable corepack and setup pnpm
RUN /root/.local/share/fnm/current/bin/corepack enable && \
    /root/.local/share/fnm/current/bin/corepack prepare pnpm@latest --activate && \
    /root/.local/share/fnm/current/bin/pnpm --version

WORKDIR /app

# ==============================================================================
# DEPS STAGE
# ==============================================================================
FROM base AS deps

# Copy package files from the lms-app-frontend subdirectory
COPY lms-app-frontend/package.json lms-app-frontend/pnpm-lock.yaml* ./

# Install dependencies
RUN /root/.local/share/fnm/current/bin/pnpm install --frozen-lockfile

# ==============================================================================
# BUILDER STAGE
# ==============================================================================
FROM base AS builder

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy ALL frontend source code from the subdirectory
COPY lms-app-frontend/ .

# Build the application
RUN /root/.local/share/fnm/current/bin/pnpm run build

# ==============================================================================
# PRODUCTION STAGE
# ==============================================================================
FROM alpine:latest AS production

# Install Node.js directly for production
RUN apk add --no-cache nodejs npm && \
    corepack enable && \
    corepack prepare pnpm@latest --activate

# Set up non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

WORKDIR /app

# Copy built files from the builder
COPY --from=builder /app/dist ./

# Install serve (switch to root temporarily)
USER root
RUN pnpm add -g serve
USER appuser

EXPOSE 3000

CMD ["pnpm", "exec", "serve", "-s", ".", "-l", "3000"]

# ==============================================================================
# DEV STAGE - Simplified and reliable
# ==============================================================================
FROM node:22-alpine AS dev

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# HMR configuration
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
ENV HOST=0.0.0.0

# Copy package files
COPY lms-app-frontend/package.json lms-app-frontend/pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY lms-app-frontend/ .

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
